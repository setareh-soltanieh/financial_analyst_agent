# Required by langchain-anthropic.
ANTHROPIC_API_KEY=

# SEC requests must identify the application and a contact email.
EDGAR_IDENTITY="Financial Analyst Agent contact@example.com"

# Optional: enable Tavily web research and Alpha Vantage market data.
TAVILY_API_KEY=
ALPHAVANTAGE_API_KEY=

# Required to push eval results to Braintrust (tests/financial_analyst.eval.py).
BRAINTRUST_API_KEY=
# Optional: Braintrust project name to log experiments under (default: financial-analyst-agent).
BRAINTRUST_PROJECT=
